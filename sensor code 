#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// -------- Wi-Fi Access Point --------
const char* ssid = "SmartPlant_D1";
const char* password = "Plant1234";

ESP8266WebServer server(80);

// -------- Pin Configuration --------
#define SOIL_PIN A0
#define RELAY_PIN D5
#define BUZZER_PIN D6
#define LED_PIN D7

// -------- LCD Configuration --------
LiquidCrystal_I2C lcd(0x27, 16, 2);

// -------- Sensor Calibration --------
// Apne sensor ke actual dry/wet readings ke
// hisab se in values ko adjust karein.
int DRY_VALUE = 800;
int WET_VALUE = 350;

// -------- Moisture Thresholds --------
const int PUMP_ON_LEVEL = 35;
const int PUMP_OFF_LEVEL = 50;

// Relay module active LOW hai to ye settings use karein.
// Agar relay active HIGH hai, to dono values ulat dein.
const int RELAY_ON = LOW;
const int RELAY_OFF = HIGH;

// -------- System Variables --------
int rawValue = 0;
int moisture = 0;

bool pumpOn = false;
bool autoMode = true;

unsigned long lastLCDUpdate = 0;
bool lcdPage = false;

// -------- Read Soil Moisture --------
void readSoil() {
  rawValue = analogRead(SOIL_PIN);

  moisture = map(rawValue, DRY_VALUE, WET_VALUE, 0, 100);
  moisture = constrain(moisture, 0, 100);
}

// -------- Pump Control --------
void setPump(bool state) {
  pumpOn = state;
  digitalWrite(RELAY_PIN, pumpOn ? RELAY_ON : RELAY_OFF);
}

// -------- Automatic Irrigation --------
void automaticControl() {
  if (!autoMode) return;

  if (moisture < PUMP_ON_LEVEL) {
    setPump(true);
  } else if (moisture >= PUMP_OFF_LEVEL) {
    setPump(false);
  }
}

// -------- Buzzer and LED --------
void updateIndicators() {
  // Dry soil par buzzer continuously active rahega.
  // Ye active buzzer ke liye hai.
  if (moisture < PUMP_ON_LEVEL) {
    digitalWrite(BUZZER_PIN, HIGH);
    digitalWrite(LED_PIN, HIGH);
  } else {
    digitalWrite(BUZZER_PIN, LOW);
    digitalWrite(LED_PIN, LOW);
  }
}

// -------- LCD Display --------
void updateLCD() {
  if (millis() - lastLCDUpdate < 2000) return;

  lastLCDUpdate = millis();
  lcdPage = !lcdPage;

  lcd.clear();

  if (!lcdPage) {
    lcd.setCursor(0, 0);
    lcd.print("Soil: ");
    lcd.print(moisture);
    lcd.print("%");

    lcd.setCursor(0, 1);
    if (moisture < PUMP_ON_LEVEL) {
      lcd.print("Soil is DRY!");
    } else if (moisture < PUMP_OFF_LEVEL) {
      lcd.print("Soil is NORMAL");
    } else {
      lcd.print("Soil is WET");
    }
  } else {
    lcd.setCursor(0, 0);
    lcd.print("Pump: ");
    lcd.print(pumpOn ? "ON" : "OFF");

    lcd.setCursor(0, 1);
    lcd.print("Mode: ");
    lcd.print(autoMode ? "AUTO" : "MANUAL");
  }
}

