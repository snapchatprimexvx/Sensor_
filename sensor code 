// -------- Web Server Handlers --------
void handleRoot() {
  server.send(200, "text/html", makePage());
}

void handleAPI() {
  String soilStatus;

  if (moisture < PUMP_ON_LEVEL) {
    soilStatus = "DRY";
  } else if (moisture < PUMP_OFF_LEVEL) {
    soilStatus = "NORMAL";
  } else {
    soilStatus = "WET";
  }

  String json = "{";
  json += "\"moisture\":" + String(moisture) + ",";
  json += "\"raw\":" + String(rawValue) + ",";
  json += "\"pump\":" + String(pumpOn ? "true" : "false") + ",";
  json += "\"auto\":" + String(autoMode ? "true" : "false") + ",";
  json += "\"soil\":\"" + soilStatus + "\"";
  json += "}";

  server.send(200, "application/json", json);
}

void handleMode() {
  if (!server.hasArg("set")) {
    server.send(400, "text/plain", "Missing mode");
    return;
  }

  String mode = server.arg("set");

  if (mode == "auto") {
    autoMode = true;
    automaticControl();
    server.send(200, "text/plain", "AUTO mode enabled");
  } else if (mode == "manual") {
    autoMode = false;
    server.send(200, "text/plain", "MANUAL mode enabled");
  } else {
    server.send(400, "text/plain", "Invalid mode");
  }
}

void handlePump() {
  if (!server.hasArg("state")) {
    server.send(400, "text/plain", "Missing state");
    return;
  }

  if (autoMode) {
    server.send(409, "text/plain",
                "Switch to MANUAL mode first");
    return;
  }

  String state = server.arg("state");

  if (state == "on") {
    setPump(true);
    server.send(200, "text/plain", "Pump ON");
  } else if (state == "off") {
    setPump(false);
    server.send(200, "text/plain", "Pump OFF");
  } else {
    server.send(400, "text/plain", "Invalid state");
  }
}

// -------- Setup --------
void setup() {
  Serial.begin(115200);

  pinMode(RELAY_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(RELAY_PIN, RELAY_OFF);
  digitalWrite(BUZZER_PIN, LOW);
  digitalWrite(LED_PIN, LOW);

  Wire.begin(D2, D1);

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Smart Plant");
  lcd.setCursor(0, 1);
  lcd.print("Starting...");

  readSoil();

  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);

  server.on("/", handleRoot);
  server.on("/api", handleAPI);
  server.on("/mode", handleMode);
  server.on("/pump", handlePump);

  server.begin();

  Serial.println();
  Serial.println("Smart Plant System Started");
  Serial.print("Wi-Fi Name: ");
  Serial.println(ssid);
  Serial.print("Wi-Fi Password: ");
  Serial.println(password);
  Serial.print("Dashboard: http://");
  Serial.println(WiFi.softAPIP());
}

// -------- Main Loop --------
void loop() {
  server.handleClient();

  readSoil();
  automaticControl();
  updateIndicators();
  updateLCD();

  Serial.print("Raw: ");
  Serial.print(rawValue);
  Serial.print(" | Moisture: ");
  Serial.print(moisture);
  Serial.print("% | Pump: ");
  Serial.print(pumpOn ? "ON" : "OFF");
  Serial.print(" | Mode: ");
  Serial.println(autoMode ? "AUTO" : "MANUAL");

  delay(200);
}